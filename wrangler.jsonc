{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "twinfield-connect",
	"account_id": "5f71982b62808e9ad56021b0737d80d0",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"routes": [
		{ "pattern": "connect.twinfield.solvebeam.com", "custom_domain": true }
	],
	"kv_namespaces": [
		{ "binding": "CLIENTS", "id": "28a3c136dc5e4dff8203660d610278c2" }
	],
	"ratelimits": [
		// Registrations per IP address per minute.
		{ "name": "REGISTER_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
	],
	"observability": { "enabled": true }
}
